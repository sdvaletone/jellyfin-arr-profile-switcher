<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net9.0 is what Jellyfin 10.11.x targets (same pinning rationale as
      src/jellyfin-loudness-normalizer/Jellyfin.Plugin.LoudnessNormalizer.csproj,
      verified against Jellyfin.Controller 10.11.11's nuspec).
    -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ArrProfileSwitcher</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ArrProfileSwitcher</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the exact running server version (10.11.11), matching the
      loudness-normalizer plugin. ExcludeAssets=runtime keeps Jellyfin's own
      assemblies out of the publish output - the packaged artifact must be
      just Jellyfin.Plugin.ArrProfileSwitcher.dll + meta.json.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!--
      Needed only to build the JObject payload handed to the File
      Transformation plugin's reflection-based registration API (see
      Services/StartupService.cs) - Jellyfin itself already loads
      Newtonsoft.Json at runtime (confirmed live: the installed
      jellyfin-plugin-home-sections 2.5.11.0 references it the same way),
      so ExcludeAssets=runtime avoids shipping a second copy.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- ControllerBase / [ApiController] / [Authorize] for the API controller. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project call TryGetProviderId directly without a Jellyfin runtime. -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.ArrProfileSwitcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\arrprofileswitcher.html" />
    <EmbeddedResource Include="Configuration\arrprofileswitcher.html" />
    <None Remove="ClientScript\arr-profile-switcher.js" />
    <EmbeddedResource Include="ClientScript\arr-profile-switcher.js" />
    <None Remove="ClientScript\arr-profile-switcher.css" />
    <EmbeddedResource Include="ClientScript\arr-profile-switcher.css" />
  </ItemGroup>

</Project>
