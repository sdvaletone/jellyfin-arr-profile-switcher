<Project>
  <!--
    Plugin assembly version. Jellyfin derives BasePlugin.Version from the
    assembly version. Keep this in sync with build.yaml's `version:` and
    meta.json's `version:` on every release (same convention as
    src/jellyfin-loudness-normalizer/Directory.Build.props).
  -->
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
</Project>
